{
  "manifest_version": 3,
  "name": "Suno Captcha Helper",
  "version": "0.2.12",
  "description": "Experimental helper for suno-cli captcha-required troubleshooting.",
  "permissions": ["storage", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Suno Captcha Helper"
  },
  "content_scripts": [
    {
      "matches": ["https://suno.com/*", "https://*.suno.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://suno.com/*", "https://*.suno.com/*"],
      "js": ["command.js", "banner.js", "bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
